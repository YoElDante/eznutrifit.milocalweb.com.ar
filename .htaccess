# MiLocalWeb — Landing Page de Cliente
# Reglas de seguridad, caché y rendimiento.

# Sin listados de directorio si falta un index.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ---- Headers de seguridad ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS: los navegadores lo ignoran sobre HTTP, no necesita condición.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://maps.googleapis.com; frame-src https://www.google.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; media-src 'self';"
</IfModule>

# ---- Página 404 (ruta inexistente) ----
ErrorDocument 404 /404.php

# ---- Cache para assets ----
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

<FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# ---- URLs limpias y seguridad básica ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear código, documentación interna, metadatos y archivos de trabajo.
    RewriteRule ^(?:config\.php|includes|tools|docs|skills|\.git|\.atl)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:AGENTS|README)\.md$ - [F,L,NC]

    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
